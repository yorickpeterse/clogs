import clogs
import clogs.config (CONFIG_FILE, Config)
import clogs.git (Repository)
import clogs.helpers (read, with_directory, with_repository)
import std.env
import std.fmt (fmt)
import std.stdio (Stdout)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.fork(
    'clogs.run with the help flag',
    child: fn { clogs.run(['--help'], '.'.to_path, sandbox: true) },
    test: fn (t, p) {
      t.true(p.spawn.stdout.contains?('Show this help message'))
    },
  )

  t.fork(
    'clogs.run without any arguments',
    child: fn { clogs.run([], '.'.to_path, sandbox: true) },
    test: fn (t, p) {
      t.true(p.spawn.stdout.contains?('Show this help message'))
    },
  )

  t.fork(
    'clogs.run with the version flag',
    child: fn { clogs.run(['--version'], '.'.to_path, sandbox: true) },
    test: fn (t, p) { t.true(p.spawn.stdout.contains?('clogs')) },
  )

  t.test('clogs.run with an invalid option', fn (t) {
    t.true(clogs.run(['--foobar'], '.'.to_path, sandbox: false).error?)
  })

  t.test('clogs.run with the "init" command', fn (t) {
    with_directory(t.id, fn (path) {
      t.true(clogs.run(['init'], path, sandbox: false).ok?)
      t.true(path.join(CONFIG_FILE).file?)
    })
  })

  t.test(
    'clogs.run with the "init" command and an existing configuration',
    fn (t) {
      with_directory(t.id, fn (path) {
        Config.default(path).save(path.join(CONFIG_FILE)).get
        t.true(clogs.run(['init'], path, sandbox: false).error?)
      })
    },
  )

  t.test('clogs.run with an invalid version', fn (t) {
    with_directory(t.id, fn (path) {
      t.true(clogs.run(['a.b.c'], path, sandbox: false).error?)
    })
  })

  t.fork(
    'clogs.run with a valid untagged version',
    child: fn {
      let path = env.get('INKO_PATH').or_panic.to_path
      let res = clogs.run(['1.0.0'], path, sandbox: true)
      let _ = Stdout.new.write(fmt(res))
    },
    test: fn (t, p) {
      let mut p = Option.Some(p)

      with_repository(t.id, fn move (repo, _) {
        let p = (p := Option.None).get

        p.variable('INKO_PATH', repo.path.to_string)
        Config.default(repo.path).save(repo.path.join(CONFIG_FILE)).get

        let child = p.spawn

        t.equal(child.stdout, 'Ok(nil)')
        t.equal(child.stderr, '')
        t.equal(child.status.to_int, 0)

        let changelog = read(repo.path.join('CHANGELOG.md'))

        t.true(changelog.contains?('Bar'))
        t.false(changelog.contains?('Foo'))
        t.false(changelog.contains?('Baz'))
      })
    },
  )

  t.fork(
    'clogs.run with an already tagged version',
    child: fn {
      let path = env.get('INKO_PATH').or_panic.to_path
      let res = clogs.run(['1.0.0'], path, sandbox: true)
      let _ = Stdout.new.write(fmt(res))
    },
    test: fn (t, p) {
      let mut p = Option.Some(p)

      with_repository(t.id, fn move (repo, _) {
        let p = (p := Option.None).get

        p.variable('INKO_PATH', repo.path.to_string)
        Config.default(repo.path).save(repo.path.join(CONFIG_FILE)).get

        let _ = repo.run('tag', ['1.0.0']).get

        let child = p.spawn

        t.equal(child.stdout, 'Ok(nil)')
        t.equal(child.stderr, '')
        t.equal(child.status.to_int, 0)

        let changelog = read(repo.path.join('CHANGELOG.md'))

        t.true(changelog.contains?('Bar'))
        t.false(changelog.contains?('Foo'))
        t.false(changelog.contains?('Baz'))
      })
    },
  )

  t.test('clogs.run with an invalid configuration file', fn (t) {
    with_directory(t.id, fn (path) {
      t.true(
        clogs
          .run(
            ['--config', 'clogs-invalid.json', '1.0.0'],
            path,
            sandbox: false,
          )
          .error?,
      )
    })
  })

  t.test('clogs.run with an invalid Git repository', fn (t) {
    with_directory(t.id, fn (path) {
      Config.default(path).save(path.join(CONFIG_FILE)).get
      t.true(clogs.run(['1.0.0'], path, sandbox: false).error?)
    })
  })

  t.test('clogs.run with an empty repository', fn (t) {
    with_directory(t.id, fn (path) {
      Config.default(path).save(path.join(CONFIG_FILE)).get

      let _ = Repository.new(path).run('init', []).get

      t.true(clogs.run(['1.0.0'], path, sandbox: false).error?)
    })
  })
}
